function struct_out = config_bus()
    % CONFIG_FEM_TEMPLATE Generates a FEM structural template.
    %
    % This function outputs a struct formatted for the 'fem' class methods.
    % It contains two primary sub-arrays: .nodes and .elements.
    % Use this file as a reference or copy it to create new substructures.
    % If copying, rename 'config_fem_template' to 'config_[desired
    % structure name]' in the function line and the file name.
    
    struct_out = struct();
    
    %% =====================================================================
    %  NODE DEFINITIONS
    %  =====================================================================
    %  Each node requires the following fields:
    %  - id          : [String] Unique identifier for the node.
    %  - x, y        : [Double] Spatial coordinates in meters (m).
    %  - mass        : [Double] Point translational mass in kg.
    %  - inertia     : [Double] Point rotational mass moment of inertia in kg*m^2.
    %  - constraints : [1x3 Array] Boundary conditions for [x, y, theta].
    %                  0 = Free to move.
    %                  1 = Fixed / Grounded to the "universe".
    %  - k_rot       : [Double] Rotational stiffness in N*m/rad. Used to ground 
    %                  rotational DOFs (e.g., modeling an ACS or preventing 
    %                  singular matrices on pin joints).
    
    % Nodes: Bus
    m_bus_node = 50; I_bus_node = 100;
    struct_out.nodes(1) = struct(...
        'id', "Bus Bottom Left", ...
        'x', -3, 'y', 0, ...
        'mass', m_bus_node, 'inertia', I_bus_node, ...
        'constraints', [0, 0, 0], 'k_rot', 0); 
    struct_out.nodes(2) = struct(...
        'id', "Bus Top Left", ...
        'x', -3, 'y', 3, ...
        'mass', m_bus_node, 'inertia', I_bus_node, ...
        'constraints', [0, 0, 0], 'k_rot', 0); 
    struct_out.nodes(3) = struct(...
        'id', "Bus Bottom Right", ...
        'x', 3, 'y', 0, ...
        'mass', m_bus_node, 'inertia', I_bus_node, ...
        'constraints', [0, 0, 0], 'k_rot', 0); 
    struct_out.nodes(4) = struct(...
        'id', "Bus Top Right", ...
        'x', 3, 'y', 3, ...
        'mass', m_bus_node, 'inertia', I_bus_node, ...
        'constraints', [0, 0, 0], 'k_rot', 0); 
    
    % Nodes: Reaction Wheel Assemblies (RWAs)
    m_rwa_node = 10; I_rwa_node = 5;
    struct_out.nodes(5) = struct(...
        'id', "RWA Left", ...
        'x', -2, 'y', 1, ...
        'mass', m_rwa_node, 'inertia', I_rwa_node, ...
        'constraints', [0, 0, 0], 'k_rot', 0);
    struct_out.nodes(6) = struct(...
        'id', "RWA Right", ...
        'x', 2, 'y', 1, ...
        'mass', m_rwa_node, 'inertia', I_rwa_node, ...
        'constraints', [0, 0, 0], 'k_rot', 0);
    
    % Nodes: Solar Array Wing Assemblys (SAWAs)
    m_sawa_node = 2; I_sawa_node = 1;
    struct_out.nodes(7) = struct(...
        'id', "SAWA Left Mid", ...
        'x', -5.5, 'y', 0, ...
        'mass', m_sawa_node, 'inertia', I_sawa_node, ...
        'constraints', [0, 0, 0], 'k_rot', 0);
    struct_out.nodes(8) = struct(...
        'id', "SAWA Left Tip", ...
        'x', -8, 'y', 0, ...
        'mass', m_sawa_node, 'inertia', I_sawa_node, ...
        'constraints', [0, 0, 0], 'k_rot', 0);
    struct_out.nodes(9) = struct(...
        'id', "SAWA Right Mid", ...
        'x', 5.5, 'y', 0, ...
        'mass', m_sawa_node, 'inertia', I_sawa_node, ...
        'constraints', [0, 0, 0], 'k_rot', 0);
    struct_out.nodes(10) = struct(...
        'id', "SAWA Right Tip", ...
        'x', 8, 'y', 0, ...
        'mass', m_sawa_node, 'inertia', I_sawa_node, ...
        'constraints', [0, 0, 0], 'k_rot', 0);

        
        
    %% =====================================================================
    %  ELEMENT DEFINITIONS
    %  =====================================================================
    %  Each element requires the following fields:
    %  - id          : [String] Unique identifier for the element.
    %  - type        : [String] Element formulation type. ("beam", "spring")
    %  - nodes       : [1x2 String Array] Exact IDs of the connecting nodes.
    %  - E           : [Double] Young's Modulus in Pascals (Pa).
    %  - I           : [Double] Area Moment of Inertia in m^4.
    %  - A           : [Double] Cross-sectional area in m^2.
    %  - rho         : [Double] Mass density per unit length in kg/m.
    %  - k_spring    : [1x3 Array] Local stiffness for spring elements [N/m, N/m, N*m/rad].
    %                  Format: [k_axial, k_shear, k_torsion].
    
    % Elements: Bus
    E_bus = 70e9; I_bus = 2.25; A_bus = 2*.01; rho_bus = 2700;
    struct_out.elements(1) = struct(...
        'id', "Bus Base", 'type', "beam", ...
        'nodes', ["Bus Bottom Left", "Bus Bottom Right"], ... 
        'E', E_bus, 'I', I_bus, 'A', A_bus, ...
        'rho', rho_bus,  'k_spring', [0, 0, 0]);
    struct_out.elements(2) = struct(...
        'id', "Bus Left", 'type', "beam", ...
        'nodes', ["Bus Bottom Left", "Bus Top Left"], ... 
        'E', E_bus, 'I', I_bus, 'A', A_bus, ...
        'rho', rho_bus,  k_spring', [0, 0, 0]);
    struct_out.elements(3) = struct(...
        'id', "Bus Right", 'type', "beam", ...
        'nodes', ["Bus Bottom Right", "Bus Top Right"], ... 
        'E', E_bus, 'I', I_bus, 'A', A_bus, ...
        'rho', rho_bus,  k_spring', [0, 0, 0]);
    struct_out.elements(4) = struct(...
        'id', "Bus Top", 'type', "beam", ...
        'nodes', ["Bus Top Left", "Bus Top Right"], ... 
        'E', E_bus, 'I', I_bus, 'A', A_bus, ...
        'rho', rho_bus,  k_spring', [0, 0, 0]);

    % Elements: Reaction Wheel Assembly supports
    E_rwa = 70e9; I_rwa = 0.01; A_rwa = 0.01; rho_rwa = 2700;
    struct_out.elements(5) = struct( ...
        'id', "RWA Left Support", 'type', "beam", ...
        'nodes', ["Bus Bottom Left", "RWA Left"], ...
        'E', E_rwa, 'I', I_rwa, 'A', A_rwa, ...
        'rho', rho_rwa,  k_spring', [0, 0, 0]);
    struct_out.elements(6) = struct( ...
        'id', "RWA Right Support", 'type', "beam", ...
        'nodes', ["Bus Bottom Right", "RWA Right"], ...
        'E', E_rwa, 'I', I_rwa, 'A', A_rwa, ...
        'rho', rho_rwa,  k_spring', [0, 0, 0]);

    % Elements: SAWA Structures
    E_sawa = 70e9; I_sawa = 0.01; A_sawa = 0.01; rho_sawa = 2700;
    struct_out.elements(7) = struct( ...
        'id', "SAWA Left Inner", 'type', "beam", ...
        'nodes', ["Bus Bottom Left", "SAWA Left Mid"], ...
        'E', E_sawa, 'I', I_sawa, 'A', A_sawa, ...
        'rho', rho_sawa,  k_spring', [0, 0, 0]);
    struct_out.elements(8) = struct( ...
        'id', "SAWA Left Outer", 'type', "beam", ...
        'nodes', ["SAWA Left Mid", "SAWA Left Tip"], ...
        'E', E_sawa, 'I', I_sawa, 'A', A_sawa, ...
        'rho', rho_sawa,  k_spring', [0, 0, 0]);
    struct_out.elements(9) = struct( ...
        'id', "SAWA Right Inner", 'type', "beam", ...
        'nodes', ["Bus Bottom Right", "SAWA Right Mid"], ...
        'E', E_sawa, 'I', I_sawa, 'A', A_sawa, ...
        'rho', rho_sawa,  k_spring', [0, 0, 0]);
    struct_out.elements(10) = struct( ...
        'id', "SAWA Right Outer", 'type', "beam", ...
        'nodes', ["SAWA Right Mid", "SAWA Right Tip"], ...
        'E', E_sawa, 'I', I_sawa, 'A', A_sawa, ...
        'rho', rho_sawa,  k_spring', [0, 0, 0]);


end